NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:3000

# PostgreSQL connection string for Prisma
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public

# JWT authentication
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=24h

# Initial mentor/admin account (used by prisma seed only)
MENTOR_SEED_NAME=Mentor Admin
MENTOR_SEED_EMAIL=mentor@example.com
MENTOR_SEED_PASSWORD=replace-with-a-strong-password

# Submission rate limit (in-memory; per authenticated student)
# Default: 5 attempts per 15 minutes (900000 ms)
SUBMISSION_RATE_LIMIT_MAX=5
SUBMISSION_RATE_LIMIT_WINDOW_MS=900000
