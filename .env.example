# Host port mappings
FRONTEND_PORT=3000
BACKEND_PORT=4000

# Browser-facing API URL (used at frontend build time)
NEXT_PUBLIC_API_URL=http://localhost:4000

# Allowed frontend origin for backend CORS
CORS_ORIGIN=http://localhost:3000

# PostgreSQL (Docker Compose defaults)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=project_submission
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/project_submission?schema=public

# Backend authentication (required for API)
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=24h
MENTOR_SEED_NAME=Mentor Admin
MENTOR_SEED_EMAIL=mentor@example.com
MENTOR_SEED_PASSWORD=replace-with-a-strong-password
